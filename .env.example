# Development-only example. Never copy these development settings into production.
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=
MONGO_URI=mongodb://localhost:27017/edupredict
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
TRUSTED_HOSTS=
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
RATELIMIT_STORAGE_URI=memory://
PASSWORD_RESET_EXPOSE_LINK=false
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_DEFAULT_SENDER=
PASSWORD_RESET_BASE_URL=

# Optional development bootstrap. Leave unset unless deliberately creating an admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_ADMIN_SEED=false

# Destructive demo seeding requires all three explicit confirmations and is forbidden in production.
ALLOW_DEMO_SEED=false
DEMO_SEED_DATABASE=
DEMO_SEED_PASSWORD=

# Optional integrations
HADOOP_ENABLED=false
HADOOP_NAMENODE_URL=http://localhost:50070
HADOOP_ALLOWED_HOSTS=localhost,127.0.0.1
STREAM_BACKEND=local
KAFKA_BOOTSTRAP_SERVERS=
