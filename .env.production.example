# Copy to an untracked .env.production file and replace placeholders in a secret manager.
APP_ENV=production
FLASK_ENV=production
FLASK_DEBUG=false
EDUPREDICT_IMAGE=edupredict:<PRODUCTION_RELEASE_TAG>
SECRET_KEY=
MONGO_URI=mongodb+srv://<PRODUCTION_DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER_HOST>/edupredict_prod?retryWrites=true&w=majority&tls=true
TRUSTED_HOSTS=<PRODUCTION_PUBLIC_HOSTNAME>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PASSWORD_RESET_EXPOSE_LINK=false
RATELIMIT_STORAGE_URI=<PRIVATE_REDIS_URI>
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=EduPredict <verified-sender@example.com>
PASSWORD_RESET_BASE_URL=https://<PRODUCTION_PUBLIC_HOSTNAME>
