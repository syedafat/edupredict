# Copy to an untracked .env.staging file and replace placeholders in a secret manager.
APP_ENV=staging
FLASK_ENV=staging
FLASK_DEBUG=false
EDUPREDICT_IMAGE=edupredict:<STAGING_RELEASE_TAG>
SECRET_KEY=
MONGO_URI=mongodb+srv://<STAGING_DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER_HOST>/edupredict_staging?retryWrites=true&w=majority&tls=true
TRUSTED_HOSTS=<STAGING_PUBLIC_HOSTNAME>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PASSWORD_RESET_EXPOSE_LINK=false
RATELIMIT_STORAGE_URI=<PRIVATE_REDIS_URI>
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=EduPredict <verified-sender@staging.example.com>
PASSWORD_RESET_BASE_URL=https://<STAGING_PUBLIC_HOSTNAME>
